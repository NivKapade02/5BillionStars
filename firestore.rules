rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'paQi4R2liKhkGCch2RbDNCDSXuA3';
    }
    function count(value, minimum) {
      return value is int && value >= minimum && value <= 50;
    }
    function bookingDate(value) {
      return timestamp.date(int(value.split('-')[0]), int(value.split('-')[1]), int(value.split('-')[2]));
    }
    function validQuote(d) {
      let nights = (bookingDate(d.checkOut).toMillis() - bookingDate(d.checkIn).toMillis()) / 86400000;
      let rate = d.stay == 'Tent Stay (2-3 people)' ? 999 : 1599;
      let total = (d.adults * (rate + 1) + d.kids * 700) * nights;
      return d.quote is map
        && d.quote.keys().hasAll(['nights', 'total', 'advance', 'balance'])
        && d.quote.keys().hasOnly(['nights', 'total', 'advance', 'balance'])
        && d.quote.nights == nights && d.quote.total == total
        && d.quote.advance == total * 0.4 && d.quote.balance == total * 0.6;
    }
    function validDetails(d) {
      return d.name is string && d.name.size() >= 3 && d.name.size() <= 100
        && d.phone is string && d.phone.matches('^[+][1-9][0-9]{7,14}$')
        && d.notes is string && d.notes.size() <= 200
        && d.stay in ['Tent Stay (2-3 people)', 'Cottage Stay (4-5 people)']
        && count(d.guests, 1) && count(d.adults, 1) && count(d.kids, 0)
        && count(d.veg, 0) && count(d.nonVeg, 0)
        && d.adults + d.kids <= d.guests && d.veg + d.nonVeg == d.guests
        && d.checkIn is string && d.checkOut is string
        && d.checkIn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.checkOut.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && bookingDate(d.checkOut) > bookingDate(d.checkIn)
        && validQuote(d);
    }
    function validCreate(d, id) {
      return d.keys().hasAll(['reference', 'name', 'phone', 'checkIn', 'checkOut', 'guests', 'adults', 'kids', 'veg', 'nonVeg', 'stay', 'notes', 'createdAt', 'decision', 'quote'])
        && d.keys().hasOnly(['reference', 'name', 'phone', 'checkIn', 'checkOut', 'guests', 'adults', 'kids', 'veg', 'nonVeg', 'stay', 'notes', 'createdAt', 'decision', 'quote'])
        && id.matches('^[a-f0-9-]{36}$') && d.reference == id
        && d.createdAt is timestamp
        && d.createdAt >= request.time - duration.value(15, 'm')
        && d.createdAt <= request.time + duration.value(5, 'm')
        && bookingDate(d.checkIn) >= (request.time - duration.value(1, 'd')).date()
        && d.decision == 'pending' && validDetails(d);
    }
    function validEdit() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'stay', 'checkIn', 'checkOut', 'guests', 'adults', 'kids', 'veg', 'nonVeg', 'notes', 'quote', 'decision', 'decisionAt', 'updatedAt'])
        && d.decision == 'pending' && !d.keys().hasAny(['decisionAt'])
        && d.updatedAt == request.time && validDetails(d)
        && (!d.keys().hasAny(['paidAmount']) || d.paidAmount <= d.quote.total);
    }

    match /bookingRequests/{id} {
      allow create: if validCreate(request.resource.data, id);
      allow read: if isAdmin();
      // Guests can retry an identical write, but cannot change any saved field.
      allow update: if request.resource.data == resource.data
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['decision', 'decisionAt'])
          && request.resource.data.decision in ['confirmed', 'not_confirmed']
          && request.resource.data.decisionAt == request.time)
        || (isAdmin() && validEdit())
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leadStatus', 'leadNotes', 'leadUpdatedAt'])
          && request.resource.data.leadStatus in ['Pending', 'Contacted', 'Approved', 'Closed']
          && request.resource.data.leadNotes is string && request.resource.data.leadNotes.size() <= 500
          && request.resource.data.leadUpdatedAt == request.time)
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paidAmount', 'paymentNote', 'paymentAt'])
          && request.resource.data.paidAmount is number && request.resource.data.paidAmount >= 0
          && request.resource.data.paidAmount <= resource.data.quote.total
          && request.resource.data.paymentNote is string && request.resource.data.paymentNote.size() <= 200
          && request.resource.data.paymentAt == request.time);
      allow delete: if isAdmin();
    }
    match /usageEvents/{id} {
      allow read: if isAdmin();
      allow create: if id.matches('^[a-f0-9-]{36}$')
        && request.resource.data.keys().hasAll(['visitorId', 'sessionId', 'kind', 'path', 'reference', 'device', 'browser', 'os', 'timezone', 'language', 'source', 'returning', 'elapsedSeconds', 'createdAt'])
        && request.resource.data.keys().hasOnly(['visitorId', 'sessionId', 'kind', 'path', 'reference', 'device', 'browser', 'os', 'timezone', 'language', 'source', 'returning', 'elapsedSeconds', 'createdAt'])
        && request.resource.data.visitorId is string && request.resource.data.visitorId.matches('^[a-f0-9-]{36}$')
        && request.resource.data.sessionId is string && request.resource.data.sessionId.matches('^[a-f0-9-]{36}$')
        && request.resource.data.kind in ['page_view', 'booking_open', 'booking_submitted', 'whatsapp_click', 'phone_click', 'heartbeat']
        && request.resource.data.path in ['/', '/book', '/policies']
        && request.resource.data.reference is string
        && (request.resource.data.reference == '' || request.resource.data.reference.matches('^[a-f0-9-]{36}$'))
        && request.resource.data.device in ['Mobile', 'Desktop', 'Tablet']
        && request.resource.data.browser in ['Chrome', 'Safari', 'Firefox', 'Edge', 'Other']
        && request.resource.data.os in ['Android', 'iOS', 'Windows', 'macOS', 'Linux', 'Other']
        && request.resource.data.timezone is string && request.resource.data.timezone.size() <= 64
        && request.resource.data.language is string && request.resource.data.language.size() <= 35
        && request.resource.data.source is string && request.resource.data.source.size() <= 120
        && request.resource.data.returning is bool
        && request.resource.data.elapsedSeconds is int && request.resource.data.elapsedSeconds >= 0 && request.resource.data.elapsedSeconds <= 86400
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /adminActivity/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['action', 'reference', 'actor', 'createdAt'])
        && request.resource.data.keys().hasOnly(['action', 'reference', 'actor', 'createdAt'])
        && request.resource.data.action in ['booking_edited', 'booking_deleted', 'decision_confirmed', 'decision_declined', 'lead_updated', 'payment_recorded']
        && request.resource.data.reference is string && request.resource.data.reference.matches('^[a-f0-9-]{36}$')
        && request.resource.data.actor == request.auth.uid && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

  }
}
