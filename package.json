{
  "name": "5-billion-stars",
  "version": "0.0.0",
  "scripts": {
    "optimize:media": "node scripts/optimize-media.mjs",
    "optimize:images": "node scripts/optimize-media.mjs --images-only && node scripts/optimize-gallery-images.mjs",
    "verify:media": "node scripts/optimize-media.mjs --verify",
    "verify:seo": "node scripts/verify-seo.mjs",
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "start:server": "node --env-file=.env server/index.mjs",
    "test:server": "node --test server/booking.test.mjs",
    "test:firestore": "firebase emulators:exec --config firebase.test.json --only firestore --project demo-5bs \"node --test server/firestore-rules.test.mjs\""
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.15",
    "@angular/common": "^19.2.15",
    "@angular/compiler": "^19.2.15",
    "@angular/core": "^19.2.15",
    "@angular/forms": "^19.2.15",
    "@angular/platform-browser": "^19.2.15",
    "@angular/platform-browser-dynamic": "^19.2.15",
    "@angular/platform-server": "^19.2.15",
    "@angular/router": "^19.2.15",
    "@angular/ssr": "^19.2.19",
    "@primeuix/themes": "^2.0.2",
    "bootstrap": "^5.3.8",
    "chart.js": "^4.6.1",
    "firebase": "^13.2.0",
    "ng2-charts": "^11.0.0",
    "primeng": "^21.0.2",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.19",
    "@angular/cli": "^19.2.19",
    "@angular/compiler-cli": "^19.2.15",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/jasmine": "~5.1.0",
    "baseline-browser-mapping": "^2.11.34",
    "firebase-tools": "^15.35.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "sharp": "^0.35.5",
    "typescript": "~5.8.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
